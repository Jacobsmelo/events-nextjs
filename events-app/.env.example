# Required: MongoDB connection string.
# Example for a local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/events-nextapp

# Optional: database name used by booking actions (defaults to events-nextapp).
MONGODB_DB=events-nextapp

# Required: Cloudinary account credentials for event image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required: Auth.js GitHub OAuth credentials and session secret.
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Comma-separated GitHub account email allowlist for the admin dashboard.
ADMIN_EMAILS=
